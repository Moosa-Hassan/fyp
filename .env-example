# Required: Azure OpenAI resource API key.
AZURE_OPENAI_API_KEY=

# Required: resource base URL, e.g. https://your-resource.openai.azure.com
# Do not include /openai/v1/; the code appends it.
AZURE_OPENAI_ENDPOINT=

# Required: your Azure OpenAI chat deployment name.
AZURE_OPENAI_DEPLOYMENT=

# Optional: local sentence-transformers model name or path.
# Leave empty to use the built-in hashing embeddings.
# Setting this requires the sentence-transformers package.
EMBEDDING_MODEL=
